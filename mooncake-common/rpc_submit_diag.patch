+  // Preserve coro_io cancellation and awaiter semantics. Only sampled TCP
+  // requests wrap the Asio completion callback; other paths use async_write.
+  // The callback timestamp measures its execution, not kernel completion.
+  template <typename Socket, typename Buffer>
+  static auto mooncake_submit_write(Socket &socket, Buffer buffer,
+                                   mooncake_submit_trace_t *trace) noexcept
+      -> async_simple::coro::Lazy<std::pair<std::error_code, size_t>> {
+    using Trace = mooncake_submit_trace_t;
+    if constexpr (std::is_same_v<Socket, asio::ip::tcp::socket>) {
+      if (trace) {
+        return coro_io::async_io<std::pair<std::error_code, size_t>>(
+            [&, buffer, trace](auto callback) mutable {
+              trace->write_begin_tid = Trace::Tid();
+              trace->Mark(Trace::WriteStarted);
+              asio::async_write(
+                  socket, buffer,
+                  [trace, callback = std::move(callback)](
+                      const std::error_code &ec, size_t bytes) mutable {
+                    trace->write_callback_tid = Trace::Tid();
+                    trace->Mark(Trace::WriteCallback);
+                    callback(ec, bytes);
+                  });
+            },
+            socket);
+      }
+    }
+    if (trace) {
+      trace->write_begin_tid = Trace::Tid();
+      trace->Mark(Trace::WriteStarted);
+    }
+    return coro_io::async_write(socket, buffer);
+  }
+
