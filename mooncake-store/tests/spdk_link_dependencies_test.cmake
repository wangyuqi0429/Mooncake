if(NOT DEFINED TEST_DIRECTORY)
  message(FATAL_ERROR "Pass an empty temporary TEST_DIRECTORY")
endif()
include(${CMAKE_CURRENT_LIST_DIR}/../cmake/SpdkLinkDependencies.cmake)
if(CASE STREQUAL "missing_core")
  mooncake_spdk_check_core_dpdk("${TEST_DIRECTORY}/missing")
  message(FATAL_ERROR "Missing core DPDK was incorrectly accepted")
endif()
if(CASE STREQUAL "missing_fuse")
  file(MAKE_DIRECTORY "${TEST_DIRECTORY}/fuse")
  file(WRITE "${TEST_DIRECTORY}/fuse/libspdk_fuse_dispatcher.a" "")
  set(CMAKE_FIND_ROOT_PATH "${TEST_DIRECTORY}/empty_sysroot")
  set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
  mooncake_spdk_fuse_lib(fuse "${TEST_DIRECTORY}/fuse")
  message(FATAL_ERROR "Missing fuse3 was incorrectly accepted")
endif()
file(MAKE_DIRECTORY "${TEST_DIRECTORY}/legacy" "${TEST_DIRECTORY}/split")

# An older layout without split libraries must never produce nonexistent paths.
mooncake_spdk_split_dpdk_libs(legacy "${TEST_DIRECTORY}/legacy")
if(legacy)
  message(FATAL_ERROR "Legacy DPDK linked nonexistent split archives: ${legacy}")
endif()
mooncake_spdk_fuse_lib(legacy_fuse "${TEST_DIRECTORY}/legacy")
if(legacy_fuse)
  message(FATAL_ERROR "A build without fuse_dispatcher must not require fuse3")
endif()

foreach(name log argparse cmdline)
  file(WRITE "${TEST_DIRECTORY}/split/librte_${name}.a" "")
endforeach()
mooncake_spdk_split_dpdk_libs(split "${TEST_DIRECTORY}/split")
list(LENGTH split count)
if(NOT count EQUAL 3)
  message(FATAL_ERROR "Installed split archives were not discovered: ${split}")
endif()
foreach(library IN LISTS split)
  if(NOT EXISTS "${library}")
    message(FATAL_ERROR "Linked an unavailable archive: ${library}")
  endif()
endforeach()
foreach(case missing_core missing_fuse)
  execute_process(COMMAND ${CMAKE_COMMAND}
                  -DTEST_DIRECTORY=${TEST_DIRECTORY}
                  -DCASE=${case}
                  -P ${CMAKE_CURRENT_LIST_FILE}
                  RESULT_VARIABLE result ERROR_VARIABLE diagnostic)
  if(result EQUAL 0)
    message(FATAL_ERROR "${case} was incorrectly accepted")
  endif()
  if(case STREQUAL "missing_core" AND
     NOT diagnostic MATCHES "Missing required DPDK archive")
    message(FATAL_ERROR "Unexpected core dependency diagnostic: ${diagnostic}")
  endif()
  if(case STREQUAL "missing_fuse" AND
     NOT diagnostic MATCHES "libfuse3 was not found")
    message(FATAL_ERROR "Unexpected FUSE dependency diagnostic: ${diagnostic}")
  endif()
endforeach()
message(STATUS "SPDK link dependency validation: PASS")
